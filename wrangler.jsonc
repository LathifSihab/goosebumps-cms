{
  // One Worker serves the public site (static, from site/), the CMS at /admin and its API at /api.
  // Only /admin and /api run the Worker first (for the gate); every other request is a plain static file.
  "name": "goosebumps-cms",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  // Live on the client's domain; www is canonical, the apex redirects to it (Redirect Rule in the Cloudflare dashboard).
  // workers.dev is off so the site isn't reachable (and indexable) on a second hostname.
  "workers_dev": false,
  "routes": [
    { "pattern": "www.goosebumpsevents.eu", "custom_domain": true },
    { "pattern": "goosebumpsevents.eu", "custom_domain": true }
  ],
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  // Where the CMS publishes. For the client cutover, point these at DSMeridian/goosebumpsevents.eu and SITE_DIR "".
  "vars": {
    "GH_OWNER": "LathifSihab",
    "GH_REPO": "goosebumps-cms",
    "GH_BRANCH": "main",
    "SITE_DIR": "site/"
  }
}
